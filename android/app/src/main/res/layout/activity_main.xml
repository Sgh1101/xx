<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 탭 1: 링크로 받기 -->
        <ScrollView
            android:id="@+id/pageLink"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="X 다운로더"
                    android:textColor="@color/text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="트윗 링크를 붙여넣으면 영상이 바로 저장돼요"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="https://x.com/user/status/…"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textColor="@color/text"
                        android:textColorHint="@color/muted"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btnPaste"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:contentDescription="붙여넣기"
                        android:src="@drawable/ic_paste"
                        android:tint="@color/accent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnFetch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:text="영상 가져오기"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_card"
                    android:lineSpacingExtra="4dp"
                    android:padding="18dp"
                    android:text="💡 X 앱에서 트윗의 공유 버튼 → 이 앱을 고르면 링크가 자동으로 들어와요.\n\n계정의 영상을 한꺼번에 받으려면 아래 ‘X 브라우저’ 탭을 쓰세요."
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- 탭 2: X 브라우저 -->
        <LinearLayout
            android:id="@+id/pageWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/loginHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="4dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="구글 로그인은 앱 안에서 막혀 있어요.\n이메일/사용자명 + 비밀번호로 로그인하세요. 구글로 가입했다면 ‘비밀번호를 잊으셨나요?’로 비밀번호를 만들면 돼요."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/loginHintClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:max="100"
                    android:progressTint="@color/accent"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 하단 탭바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabLink"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabLinkIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_link" />

            <TextView
                android:id="@+id/tabLinkText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="링크로 받기"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabWeb"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabWebIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_globe" />

            <TextView
                android:id="@+id/tabWebText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="X 브라우저"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
